@EmployeeManagement.API_HostAddress = http://localhost:5200

### 1. GET all employees (Check Response Headers: X-Correlation-Id & X-Response-Time-Ms)
GET {{EmployeeManagement.API_HostAddress}}/api/employees
Accept: application/json

### 2. GET all employees filtered by Department 1
GET {{EmployeeManagement.API_HostAddress}}/api/employees?departmentId=1
Accept: application/json

### 3. GET all high-earning employees (Monthly pay >= $10,000)
GET {{EmployeeManagement.API_HostAddress}}/api/employees?minPay=10000
Accept: application/json

### 4. GET employee by ID (200 OK)
GET {{EmployeeManagement.API_HostAddress}}/api/employees/101
Accept: application/json

### 5. GET non-existent employee (404 Not Found)
GET {{EmployeeManagement.API_HostAddress}}/api/employees/9999
Accept: application/json

### 6. POST create a new Full-Time Employee (201 Created)
POST {{EmployeeManagement.API_HostAddress}}/api/employees
Content-Type: application/json

{
  "name": "Sarah Connor",
  "email": "sarah.connor@cyberdyne.com",
  "departmentId": 1,
  "type": 1,
  "salaryOrHourlyRate": 135000,
  "monthlyBenefits": 900,
  "street": "100 Resistance Way",
  "city": "Los Angeles",
  "state": "CA",
  "zipCode": "90001"
}

### 7. POST create invalid employee (400 Bad Request - validation failure)
POST {{EmployeeManagement.API_HostAddress}}/api/employees
Content-Type: application/json

{
  "name": "",
  "email": "not-an-email",
  "departmentId": 0,
  "type": 1,
  "salaryOrHourlyRate": -100
}

### 8. PUT update existing employee (204 No Content)
PUT {{EmployeeManagement.API_HostAddress}}/api/employees/101
Content-Type: application/json

{
  "name": "Alice Johnson Updated",
  "email": "alice.johnson@company.com",
  "departmentId": 2,
  "street": "100 New Tech Way",
  "city": "San Francisco",
  "state": "CA",
  "zipCode": "94101"
}

### 9. PATCH update employee salary (200 OK)
PATCH {{EmployeeManagement.API_HostAddress}}/api/employees/101/salary
Content-Type: application/json

{
  "newSalaryOrRate": 145000
}

### 10. DELETE employee (204 No Content)
DELETE {{EmployeeManagement.API_HostAddress}}/api/employees/102

### 11. GET all departments
GET {{EmployeeManagement.API_HostAddress}}/api/departments
Accept: application/json

### 12. GET department payroll report & budget health
GET {{EmployeeManagement.API_HostAddress}}/api/departments/1/payroll
Accept: application/json

### 13. [DAY 7] DI LIFETIMES VERIFICATION (Transient vs Scoped vs Singleton GUIDs)
GET {{EmployeeManagement.API_HostAddress}}/api/diagnostics/lifetimes
Accept: application/json

### 14. [DAY 7] STRONGLY-TYPED CONFIGURATION (IOptions<PayrollSettings>)
GET {{EmployeeManagement.API_HostAddress}}/api/diagnostics/configuration
Accept: application/json
