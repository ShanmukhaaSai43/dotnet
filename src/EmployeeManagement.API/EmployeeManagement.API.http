@EmployeeManagement.API_HostAddress = http://localhost:5200

###############################################################################
# DAY 10: AUTHENTICATION & JWT SECURITY (GATE 2)
###############################################################################

### 1. LOGIN AS ADMIN (200 OK - Generates Admin JWT Token)
# @name adminLogin
POST {{EmployeeManagement.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### Store the Admin Token from the response
@adminToken = {{adminLogin.response.body.token}}

### 2. LOGIN AS MANAGER (200 OK - Generates Manager JWT Token)
# @name managerLogin
POST {{EmployeeManagement.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "manager",
  "password": "Manager@123"
}

### Store the Manager Token
@managerToken = {{managerLogin.response.body.token}}

### 3. LOGIN AS EMPLOYEE (200 OK - Generates Employee JWT Token)
# @name employeeLogin
POST {{EmployeeManagement.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "employee",
  "password": "Employee@123"
}

### Store the Employee Token
@employeeToken = {{employeeLogin.response.body.token}}

### 4. LOGIN FAILURE (401 Unauthorized - Invalid Credentials)
POST {{EmployeeManagement.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "WrongPassword999!"
}

### 5. GET CURRENT USER PROFILE (/api/auth/me) with Admin Token (200 OK)
GET {{EmployeeManagement.API_HostAddress}}/api/auth/me
Authorization: Bearer {{adminToken}}
Accept: application/json

### 6. [401 UNAUTHORIZED TEST] Access protected resource with NO token (401 Unauthorized)
GET {{EmployeeManagement.API_HostAddress}}/api/employees
Accept: application/json

### 7. [403 FORBIDDEN TEST] Attempt Admin-Only DELETE with Employee Token (403 Forbidden)
DELETE {{EmployeeManagement.API_HostAddress}}/api/employees/1
Authorization: Bearer {{employeeToken}}

### 8. [403 FORBIDDEN TEST] Attempt Admin-Only Salary Patch with Manager Token (403 Forbidden)
PATCH {{EmployeeManagement.API_HostAddress}}/api/employees/1/salary
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "newSalaryOrRate": 160000
}

###############################################################################
# PROTECTED EMPLOYEE & DEPARTMENT ENDPOINTS (WITH BEARER TOKENS)
###############################################################################

### 9. GET ALL EMPLOYEES (200 OK - Authorized with Employee Token)
GET {{EmployeeManagement.API_HostAddress}}/api/employees
Authorization: Bearer {{employeeToken}}
Accept: application/json

### 10. GET PAGED EMPLOYEES (200 OK - Server-Side Filtering, Sorting, Pagination)
GET {{EmployeeManagement.API_HostAddress}}/api/employees/paged?pageNumber=1&pageSize=5&sortBy=name&sortDescending=false
Authorization: Bearer {{employeeToken}}
Accept: application/json

### 11. GET EMPLOYEE BY ID (200 OK)
GET {{EmployeeManagement.API_HostAddress}}/api/employees/1
Authorization: Bearer {{employeeToken}}
Accept: application/json

### 12. CREATE EMPLOYEE (201 Created - Authorized with Manager Token)
POST {{EmployeeManagement.API_HostAddress}}/api/employees
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Sarah Connor",
  "email": "sarah.connor@cyberdyne.com",
  "departmentId": 1,
  "type": 1,
  "salaryOrHourlyRate": 135000,
  "monthlyBenefits": 900,
  "street": "100 Resistance Way",
  "city": "Los Angeles",
  "state": "CA",
  "zipCode": "90001"
}

### 13. PATCH EMPLOYEE SALARY (200 OK - Authorized with Admin Token)
PATCH {{EmployeeManagement.API_HostAddress}}/api/employees/1/salary
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "newSalaryOrRate": 150000
}

### 14. GET ALL DEPARTMENTS (200 OK)
GET {{EmployeeManagement.API_HostAddress}}/api/departments
Authorization: Bearer {{employeeToken}}
Accept: application/json

### 15. GET DEPARTMENT PAYROLL SUMMARY (200 OK - Authorized with Manager Token)
GET {{EmployeeManagement.API_HostAddress}}/api/departments/1/payroll
Authorization: Bearer {{managerToken}}
Accept: application/json

### 16. DELETE EMPLOYEE (204 No Content - Authorized with Admin Token)
DELETE {{EmployeeManagement.API_HostAddress}}/api/employees/2
Authorization: Bearer {{adminToken}}

###############################################################################
# DAY 7 & 8 DIAGNOSTICS & EXCEPTION TESTS
###############################################################################

### 17. DI LIFETIMES VERIFICATION (Transient vs Scoped vs Singleton GUIDs)
GET {{EmployeeManagement.API_HostAddress}}/api/diagnostics/lifetimes
Accept: application/json

### 18. STRONGLY-TYPED CONFIGURATION (IOptions<PayrollSettings>)
GET {{EmployeeManagement.API_HostAddress}}/api/diagnostics/configuration
Accept: application/json

### 19. RFC 7807 FLUENTVALIDATION FAILURE (400 Bad Request)
POST {{EmployeeManagement.API_HostAddress}}/api/employees
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "email": "not-an-email",
  "departmentId": 0,
  "type": 1,
  "salaryOrHourlyRate": -100
}
